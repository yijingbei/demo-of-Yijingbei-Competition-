+    def visibility_blocker(self, start_m: Vector3V2, end_m: Vector3V2) -> str | None:
+        """Return immutable map evidence; no implicit wall at a 2D shoreline."""
+        start = _vector3(start_m, path=("visibility", "start_m"))
