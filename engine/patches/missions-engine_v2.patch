+def combat_settlement_ready_v2(activity: Mapping[str, int] | None) -> bool:
+    """Fail closed unless current authoritative combat work is completely drained.
+
+    This says nothing about mission success or surviving enemies. Scenarios must
+    still declare those conditions, including future waves, independently.
+    """
+    if activity is None or set(activity) != COMBAT_ACTIVITY_FIELDS_V2 or any(
+        type(value) is not int or value < 0 for value in activity.values()
+    ):
+        raise ValueError("current native combat activity evidence is missing or invalid")
+    return not any(activity.values())
 
 
