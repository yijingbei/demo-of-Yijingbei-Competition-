+def _rigid_sweep_fraction(
+    a: CollisionShapeV2,
+    a0: Vector3V2,
+    a1: Vector3V2,
+    b: CollisionShapeV2,
+    b0: Vector3V2,
+    b1: Vector3V2,
+    yaw_a: float,
+    yaw_b: float,
+    tolerance: float,
+) -> float | None:
+    """Conservative advancement with a bound on translation plus angular travel.
+
+    Each step is bounded by separation / maximum relative point travel, so fast
+    crossings and intermediate rotations cannot be skipped. Contact accuracy is
+    1e-7 metres; iterations fail explicitly rather than silently missing a hit.
+    """
+    if yaw_a == yaw_b == 0.0:
+        return _translation_contact(a, a0, a1, b, b0, b1, tolerance)
+    da = tuple(a1[i] - a0[i] for i in range(3))
+    db = tuple(b1[i] - b0[i] for i in range(3))
+    speed = math.sqrt(sum((da[i] - db[i]) ** 2 for i in range(3)))
+    speed += abs(math.radians(yaw_a)) * a.radius_m + abs(math.radians(yaw_b)) * b.radius_m
+    fraction = 0.0
+    epsilon = max(tolerance, 1e-7)
+    for _ in range(4096):
+        pa = cast(Vector3V2, tuple(a0[i] + fraction * da[i] for i in range(3)))
+        pb = cast(Vector3V2, tuple(b0[i] + fraction * db[i] for i in range(3)))
+        gap, _normal = _shape_gap(
+            _rotated(a, yaw_a * fraction), pa, _rotated(b, yaw_b * fraction), pb
+        )
+        if gap <= epsilon:
+            return fraction
+        if speed == 0.0 or gap > speed * (1.0 - fraction) + epsilon:
+            return None
+        fraction += gap / speed
+        if fraction > 1.0:
+            return None
+    raise ValueError("continuous shape sweep did not converge")
+
