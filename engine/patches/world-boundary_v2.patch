+def _translation_contact(
+    a: CollisionShapeV2,
+    a0: Vector3V2,
+    a1: Vector3V2,
+    b: CollisionShapeV2,
+    b0: Vector3V2,
+    b1: Vector3V2,
+    tolerance: float,
+) -> float | None:
+    """Exact translational SAT for boxes; piecewise quadratic sphere/box sweep."""
+    start = tuple(a0[i] - b0[i] for i in range(3))
+    end = tuple(a1[i] - b1[i] for i in range(3))
+    if a.shape == "sphere" or b.shape == "sphere":
+        if b.shape == "sphere":
+            return _translation_contact(b, b0, b1, a, a0, a1, tolerance)
+        yaw = math.radians(b.yaw_degrees if b.shape == "obb" else 0.0)
+        c, s = math.cos(yaw), math.sin(yaw)
+        local_start = (c * start[0] + s * start[1], -s * start[0] + c * start[1], start[2])
+        local_end = (c * end[0] + s * end[1], -s * end[0] + c * end[1], end[2])
+        delta = tuple(local_end[i] - local_start[i] for i in range(3))
+        breaks = {0.0, 1.0}
+        for i in range(3):
+            if delta[i]:
+                for edge in (-b.half_extents_m[i], b.half_extents_m[i]):
+                    t = (edge - local_start[i]) / delta[i]
+                    if 0.0 < t < 1.0:
+                        breaks.add(t)
+        times = sorted(breaks)
+        radius = a.radius_m + tolerance
+        for lower, upper in zip(times, times[1:], strict=False):
+            mid = (lower + upper) / 2.0
+            offset, velocity = [], []
+            for i in range(3):
+                x = local_start[i] + mid * delta[i]
+                extent = b.half_extents_m[i]
+                if abs(x) <= extent:
+                    offset.append(0.0)
+                    velocity.append(0.0)
+                else:
+                    edge = extent if x > 0.0 else -extent
+                    offset.append(local_start[i] + lower * delta[i] - edge)
+                    velocity.append(delta[i] * (upper - lower))
+            hit = _sphere_sweep_fraction(
+                tuple(offset), tuple(offset[i] + velocity[i] for i in range(3)), radius, 0.0
+            )
+            if hit is not None:
+                return lower + hit * (upper - lower)
+        return None
+    axes = [(0.0, 0.0, 1.0)]
+    for shape in (a, b):
+        yaw = math.radians(shape.yaw_degrees if shape.shape == "obb" else 0.0)
+        c, s = math.cos(yaw), math.sin(yaw)
+        axes.extend(((c, s, 0.0), (-s, c, 0.0)))
+    entry, exit_time = 0.0, 1.0
+    for axis in axes:
+        if axis[2]:
+            radius = a.half_extents_m[2] + b.half_extents_m[2]
+        else:
+            radius = sum(
+                max(abs(x * axis[0] + y * axis[1]) for x, y in _shape_polygon(shape))
+                for shape in (a, b)
+            )
+        interval = _linear_interval(
+            sum(start[i] * axis[i] for i in range(3)),
+            sum(end[i] * axis[i] for i in range(3)),
+            -radius - tolerance,
+            radius + tolerance,
+        )
+        if interval is None:
+            return None
+        entry, exit_time = max(entry, interval[0]), min(exit_time, interval[1])
+        if entry > exit_time:
+            return None
+    return entry
+
