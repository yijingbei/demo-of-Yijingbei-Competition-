+def _motion_shape(
+    shape: CollisionShapeV2, motion: MotionSegmentV2
+) -> tuple[CollisionShapeV2, float]:
+    if shape.shape != "obb" or motion.start_heading_deg is None:
+        return shape, 0.0
+    # Navigation heading: clockwise from north; geometry yaw: CCW from east.
+    end = motion.start_heading_deg if motion.end_heading_deg is None else motion.end_heading_deg
+    turn = (end - motion.start_heading_deg + 180.0) % 360.0 - 180.0
+    return _rotated(shape, 90.0 - motion.start_heading_deg), -turn
