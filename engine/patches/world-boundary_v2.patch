+def _shape_gap(
+    a: CollisionShapeV2,
+    pa: Vector3V2,
+    b: CollisionShapeV2,
+    pb: Vector3V2,
+) -> tuple[float, Vector3V2]:
+    """Separation lower bound and normal pointing from B to A.
+
+    Box pairs use separating axes (including Z). Sphere/box uses exact closest
+    point distance, so rounded corners are not replaced with an inflated box.
+    """
+    if a.shape == "sphere" and b.shape == "sphere":
+        delta = tuple(pa[i] - pb[i] for i in range(3))
+        length = math.sqrt(sum(x * x for x in delta))
+        normal = (1.0, 0.0, 0.0) if length == 0.0 else tuple(x / length for x in delta)
+        return length - a.radius_m - b.radius_m, cast(Vector3V2, normal)
+    if b.shape == "sphere":
+        gap, normal = _shape_gap(b, pb, a, pa)
+        return gap, cast(Vector3V2, tuple(-x for x in normal))
+    if a.shape == "sphere":
+        yaw = math.radians(b.yaw_degrees if b.shape == "obb" else 0.0)
+        c, s = math.cos(yaw), math.sin(yaw)
+        dx, dy, dz = (pa[i] - pb[i] for i in range(3))
+        local = (c * dx + s * dy, -s * dx + c * dy, dz)
+        offset = tuple(
+            local[i] - max(-b.half_extents_m[i], min(b.half_extents_m[i], local[i]))
+            for i in range(3)
+        )
+        length = math.sqrt(sum(x * x for x in offset))
+        if length == 0.0:
+            axis = min(range(3), key=lambda i: b.half_extents_m[i] - abs(local[i]))
+            normal = tuple(
+                (1.0 if local[i] >= 0.0 else -1.0) if i == axis else 0.0 for i in range(3)
+            )
+        else:
+            normal = tuple(x / length for x in offset)
+        return length - a.radius_m, (
+            c * normal[0] - s * normal[1],
+            s * normal[0] + c * normal[1],
+            normal[2],
+        )
+    axes = [(0.0, 0.0, 1.0)]
+    polygons = (_shape_polygon(a), _shape_polygon(b))
+    for shape in (a, b):
+        yaw = math.radians(shape.yaw_degrees if shape.shape == "obb" else 0.0)
+        c, s = math.cos(yaw), math.sin(yaw)
+        axes.extend(((c, s, 0.0), (-s, c, 0.0)))
+    best, normal = -math.inf, (1.0, 0.0, 0.0)
+    for axis in axes:
+        center = sum((pa[i] - pb[i]) * axis[i] for i in range(3))
+        if axis[2]:
+            radius = a.half_extents_m[2] + b.half_extents_m[2]
+        else:
+            radius = sum(max(abs(x * axis[0] + y * axis[1]) for x, y in poly) for poly in polygons)
+        gap = abs(center) - radius
+        if gap > best:
+            best = gap
+            normal = tuple(x * (1.0 if center >= 0.0 else -1.0) for x in axis)
+    return best, cast(Vector3V2, normal)
