+    @staticmethod
+    def _native_surface_yaw(snapshot: NativeDynamicsSnapshotV2) -> float | None:
+        core = snapshot.native_state.get("core", {})
+        state = core.get("state") if isinstance(core, Mapping) else None
+        if not isinstance(state, Mapping):
+            return None
+        return float(state["body_velocity_mps"][2])
+
+    def _dissipate_surface_coast(self, adapter: Any, entity_id: str,
+                                state: DynamicsStateV2, output: DynamicsStateV2,
+                                before: NativeDynamicsSnapshotV2, dt: float,
+                                policy: Any) -> tuple[DynamicsStateV2, Mapping[str, Any]]:
+        """Native zero-thrust integration followed by a viscous velocity kick.
+
+        Integrated position/heading are kept. World and the native surge/sway/
+        yaw continuation receive the same dissipation. Rest requires continuous
+        small measured motion; it never removes the retained collision hull.
+        """
+        continuation = _plain(adapter.snapshot().native_state)
+        core_state = continuation["core"]["state"]
+        original_body = list(core_state["body_velocity_mps"])
+        linear = math.exp(-policy.linear_drag_per_s * dt)
+        angular = math.exp(-policy.angular_drag_per_s * dt)
+        body = [original_body[0] * linear, original_body[1] * linear,
+                original_body[2] * angular]
+        velocity = tuple(v * linear for v in output.velocity_mps)
+        prior = None
+        if self._world_tick_ledger:
+            previous = next(reversed(self._world_tick_ledger.values()))[1]
+            if previous.tick == self.tick:
+                prior = next((r.passive_surface for r in previous.dynamics_receipts
+                              if r.entity_id == entity_id), None)
+        input_yaw = self._native_surface_yaw(before) or 0.0
+        below = (math.hypot(*state.velocity_mps[:2]) <= policy.rest_speed_mps
+                 and math.hypot(*velocity[:2]) <= policy.rest_speed_mps
+                 and abs(math.degrees(input_yaw)) <= policy.rest_yaw_rate_deg_s
+                 and abs(math.degrees(body[2])) <= policy.rest_yaw_rate_deg_s)
+        stable = (float(prior.get("stable_seconds", 0.0)) if prior else 0.0) + dt if below else 0.0
+        resting = stable >= policy.stable_seconds
+        if resting:
+            velocity = (0.0, 0.0, 0.0)
+            body = [0.0, 0.0, 0.0]
+        result = output.model_copy(update={"velocity_mps": velocity})
+        core_state["body_velocity_mps"] = body
+        continuation["last_state"] = result.model_dump(mode="json")
+        restore = getattr(adapter, "_restore_native_state", None)
+        if not callable(restore):
+            raise ValueError("passive surface adapter lacks trusted continuation restoration")
+        restore(continuation)
+        return result, dict(model=policy.model, unconstrained_state=output.model_dump(mode="json"),
+            native_body_velocity_before=original_body, native_body_velocity_after=body,
+            linear_drag_per_s=policy.linear_drag_per_s, angular_drag_per_s=policy.angular_drag_per_s,
+            stable_seconds=stable, resting=resting, rest_speed_mps=policy.rest_speed_mps,
+            rest_yaw_rate_deg_s=policy.rest_yaw_rate_deg_s)
+
