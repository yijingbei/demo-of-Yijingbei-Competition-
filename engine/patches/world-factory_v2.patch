+    def _passive_air_motion(self, entity_id: str, dt: float) -> tuple[tuple[float, float, float], tuple[float, float, float], Mapping[str, Any]]:
+        """Unpowered drag/gravity flight until native ground/sea surface contact.
+
+        This is a World-owned passive model, never a controller command. It
+        retains the body as a disabled obstacle after impact, without changing
+        its prior combat damage, threat membership or score attribution.
+        """
+        policy = self._resolved_scenario.world.physical_motion
+        entity = self._entities[entity_id]
+        state = entity.state
+        start, speed = tuple(state.position_m), tuple(state.velocity_mps)
+        drag, gravity = policy.air_drag_per_s, policy.gravity_mps2
+        radius = self._boundary_system._entities[entity_id].radius_m
+
+        def integrate(seconds: float) -> tuple[tuple[float, float, float], tuple[float, float, float]]:
+            decay = math.exp(-drag * seconds)
+            length = -math.expm1(-drag * seconds) / drag
+            position = (start[0] + speed[0]*length, start[1] + speed[1]*length,
+                        start[2] + (speed[2] + gravity/drag)*length - gravity*seconds/drag)
+            velocity = (speed[0]*decay, speed[1]*decay,
+                        (speed[2] + gravity/drag)*decay - gravity/drag)
+            return position, velocity
+
+        def clearance(seconds: float) -> float:
+            point, _ = integrate(seconds)
+            return point[2] - radius - self._geography.surface_elevation_m(point)
+
+        contact = None
+        if clearance(0.0) <= policy.contact_tolerance_m and speed[2] <= 0.0:
+            contact = 0.0
+        else:
+            previous = 0.0
+            for index in range(1, 17):
+                current = dt*index/16.0
+                if clearance(current) <= 0.0:
+                    lo, hi = previous, current
+                    for _ in range(32):
+                        middle = (lo+hi)/2.0
+                        if clearance(middle) > 0.0:lo = middle
+                        else:hi = middle
+                    contact = hi
+                    break
+                previous = current
+        elapsed = dt if contact is None else contact
+        position, velocity = integrate(elapsed)
+        pre_impact = velocity
+        if contact is not None:
+            position = (position[0], position[1], self._geography.surface_elevation_m(position)+radius)
+            velocity = (0.0, 0.0, 0.0)
+        evidence = dict(entity_id=entity_id, model="unpowered-drag-gravity@1",
+            control_mode="passive_air", lifecycle=state.lifecycle, dt_seconds=dt,
+            input_state=dict(position_m=start, velocity_mps=speed),
+            output_state=dict(position_m=position, velocity_mps=velocity),
+            gravity_mps2=gravity, air_drag_per_s=drag,
+            surface_contact_seconds=contact, pre_impact_velocity_mps=pre_impact,
+            phase="falling" if contact is None else "surface_impact" if contact>0.0 else "grounded")
+        return position, velocity, evidence
 
