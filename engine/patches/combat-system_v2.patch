+    @staticmethod
+    def _physical_contact(attacker: Any, target: Any) -> bool:
+        """Use the same narrowphase shapes as the native boundary system."""
+        from openmdbench.world.boundary_v2 import CollisionShapeV2, ShapeNarrowphaseOracleV2
+
+        shapes = []
+        for entity in (attacker, target):
+            ref = entity.definition.composition.collision_shape_ref
+            binding = next((b for b in entity.definition.resource_bindings.get("collision_shapes", ())
+                            if b.exact_ref == ref), None)
+            if binding is None:
+                return False
+            shapes.append(CollisionShapeV2.from_profile(
+                exact_ref=binding.exact_ref, content_hash=binding.content_hash,
+                shape=str(binding.normalized_content.get("shape")),
+                parameters=binding.normalized_content))
+        return ShapeNarrowphaseOracleV2(tolerance_m=1e-6).overlap(
+            shapes[0], attacker.state.position_m, shapes[1], target.state.position_m)
 
